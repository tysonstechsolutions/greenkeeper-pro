# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
tests/e2e/.auth/user.json

# next.js
/.next/
/out/

# serwist service worker (generated by next build)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
nul

# Local Claude Code working dir (agent worktrees, etc.)
/.claude/

# Supabase CLI local state (project-ref, versions, etc.)
supabase/.temp/

# FCM / Firebase service account keys — NEVER commit these
fcm-service-account*.json
*-service-account*.json
/firebase-adminsdk-*.json

# Equipment photos (stored in Supabase)
/equipment/

# Capacitor / Android build artifacts (keep android/ source, ignore build output)
/android/app/build/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/build/
/android/.gradle/
/android/captures/
/android/local.properties
