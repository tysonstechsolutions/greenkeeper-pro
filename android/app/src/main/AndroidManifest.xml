<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Android 11 (API 30) + Google Play Services package visibility.
      Without these entries, @capacitor-mlkit/barcode-scanning's call to
      isGoogleBarcodeScannerModuleAvailable() returns false, module install
      silently fails, and BarcodeScanner.scan() never opens on devices
      running API 30+. Adding the explicit package ref makes Play Services
      queryable so the ML Kit scanner module resolves correctly.
    -->
    <queries>
        <package android:name="com.google.android.gms" />
        <intent>
            <action android:name="com.google.mlkit.vision.codescanner.internal.ACTION_SCAN" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera (used by @capacitor/camera AND @capacitor-mlkit/barcode-scanning) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Photo picker / gallery -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Hardware feature (not required so the app still installs on tablets
         without a rear camera) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
